#!/bin/bash

# Omagif CLI — a thin wrapper over the omarchy-shell IPC, plus the bits of
# setup that want a terminal (API keys, dependency checks).

set -euo pipefail

PLUGIN_ID="stoneynutcase.omagif"
# Resolved through symlinks on purpose: `omagif install` links this script into
# ~/.local/bin, so the common way to run it is through that link. Taking the
# dirname of the link itself would put ROOT_DIR at ~/.local and every path
# built from it — setup, the provider catalogue, the example config, the
# desktop entry — would point at nothing.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omagif/config.json"

usage() {
  cat <<'EOF'
Omagif — GIF picker for the Omarchy shell

  omagif [toggle]        Toggle the GIF picker overlay (default)
  omagif open            Open the overlay
  omagif close           Close the overlay
  omagif setup [--provider <id>]
                         Pick a service, add its API key, write the config
  omagif config          Print the config path, or open it in $EDITOR
  omagif install [--force]
                         Put `omagif` on PATH and add a desktop entry.
                         --force replaces files this plugin does not own
  omagif doctor          Check dependencies, config, and plugin status
  omagif history [clear] List past searches, or forget them all
EOF
}

HISTORY="${XDG_STATE_HOME:-$HOME/.local/state}/omagif/history.json"
SAVED_PROVIDER="${XDG_STATE_HOME:-$HOME/.local/state}/omagif/provider.json"

do_history() {
  if [[ ${1:-} == "clear" ]]; then
    rm -f "$HISTORY"
    echo "Forgot every remembered search."
    echo "Note: the picker keeps its own copy until the shell reloads the file."
    return 0
  fi
  if [[ ! -f $HISTORY ]]; then
    echo "No search history yet ($HISTORY)"
    return 0
  fi
  python3 -c 'import json,sys
try:
    entries = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    entries = []
for i, entry in enumerate(entries, 1):
    print(f"{i:3}. {entry}")' "$HISTORY"
}

# Reads the config through python rather than grep so a hand-edited file with
# comments-that-aren't-JSON fails loudly here instead of silently in the shell.
config_get() {
  python3 - "$CONFIG" "$1" <<'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path) as fh:
        data = json.load(fh)
except (OSError, ValueError):
    sys.exit(0)
cur = data
for part in key.split("."):
    if not isinstance(cur, dict) or part not in cur:
        sys.exit(0)
    cur = cur[part]
print(cur if isinstance(cur, str) else json.dumps(cur))
PY
}

ipc() {
  if ! command -v omarchy-shell >/dev/null 2>&1; then
    echo "omagif: omarchy-shell is not on PATH — is the Omarchy shell running?" >&2
    exit 1
  fi
  omarchy-shell shell "$1" "$PLUGIN_ID" '{}'
}

# `omagif install` is the one thing here that writes outside the plugin's own
# checkout: a symlink on PATH and a desktop entry. Both are shared namespaces —
# another package, or an earlier hand-rolled setup, can already own those
# names, and silently replacing whatever is there is not ours to do. So each
# target is claimed only if it is absent or demonstrably ours, and --force is
# how you say otherwise.
DESKTOP_MARKER="X-Omagif-Plugin=$PLUGIN_ID"

# Ours if it is a symlink resolving to this very script. A regular file at that
# path is somebody else's `omagif`, whatever it happens to do.
owns_cli_link() {
  [[ -L $1 ]] || return 1
  [[ "$(readlink -f "$1")" == "$(readlink -f "$SCRIPT_DIR/omagif")" ]]
}

# Ours if it carries the marker line that share/omagif.desktop ships with.
owns_desktop_entry() {
  grep -qF "$DESKTOP_MARKER" "$1" 2>/dev/null
}

refuse() {
  echo "omagif: $1 already exists and was not put there by this plugin." >&2
  echo "        Left alone. Re-run as \`omagif install --force\` to replace it." >&2
}

do_install() {
  local force=false refused=0
  [[ ${1:-} == "--force" ]] && force=true

  local link="$HOME/.local/bin/omagif"
  if [[ ( -e $link || -L $link ) ]] && ! owns_cli_link "$link" && [[ $force != true ]]; then
    refuse "$link"
    refused=1
  else
    mkdir -p "$HOME/.local/bin"
    ln -sf "$SCRIPT_DIR/omagif" "$link"
    echo "Linked $link"
  fi

  local entry="$HOME/.local/share/applications/omagif.desktop"
  if [[ -f "$ROOT_DIR/share/omagif.desktop" ]]; then
    if [[ -e $entry ]] && ! owns_desktop_entry "$entry" && [[ $force != true ]]; then
      refuse "$entry"
      refused=1
    else
      mkdir -p "$HOME/.local/share/applications"
      install -m 644 "$ROOT_DIR/share/omagif.desktop" "$entry"
      command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database "$HOME/.local/share/applications" || true
      echo "Installed desktop entry"
    fi
  fi

  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) echo "Note: $HOME/.local/bin is not on your PATH." ;;
  esac

  return $refused
}

do_doctor() {
  local status=0

  echo "Dependencies:"
  for tool in curl wl-copy wtype xdg-open python3; do
    if command -v "$tool" >/dev/null 2>&1; then
      echo "  ok       $tool"
    else
      echo "  MISSING  $tool"
      status=1
    fi
  done
  if command -v notify-send >/dev/null 2>&1; then
    echo "  ok       notify-send"
  else
    echo "  absent   notify-send (optional — you just lose the confirmations)"
  fi

  echo
  echo "Config ($CONFIG):"
  if [[ -f $CONFIG ]]; then
    if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$CONFIG" 2>/dev/null; then
      echo "  INVALID  not valid JSON"
      status=1
    else
      local provider
      provider="$(config_get provider)"
      provider="${provider:-giphy}"
      # Ctrl+P remembers a swap in the state directory, and the picker honours
      # it over the config. Reporting only the config would explain the wrong
      # provider to someone asking why their searches look odd.
      local swapped
      swapped="$(python3 -c '
import json, sys
try:
    value = json.load(open(sys.argv[1])).get("provider", "")
except Exception:
    value = ""
print(str(value).strip())' "$SAVED_PROVIDER" 2>/dev/null || true)"
      if [[ -n $swapped && $swapped != "$provider" ]]; then
        echo "  provider $swapped (swapped with Ctrl+P; $provider in config)"
        provider="$swapped"
      else
        echo "  provider $provider"
      fi
      # Ask the catalogue which providers exist rather than hardcoding a list.
      while read -r id enabled keyless; do
        [[ -n $id ]] || continue
        if [[ $keyless == "True" ]]; then
          # Nothing to check — a missing key here is the normal state, not a
          # fault, so it must never be what makes doctor exit non-zero.
          echo "  ok       $id needs no key"
        elif [[ -n "$(config_get "$id.apiKey")" ]]; then
          echo "  ok       $id key present"
        elif [[ $enabled == "True" ]]; then
          echo "  absent   $id key"
          [[ $id == "$provider" ]] && status=1
        else
          echo "  n/a      $id closed to new sign-ups"
        fi
      done < <(python3 -c 'import json,sys
try:
    data = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit(0)
for entry in data.get("providers", []):
    if isinstance(entry, dict):
        print(entry.get("id",""), entry.get("enabled") is True,
              entry.get("keyless") is True)' "$ROOT_DIR/providers/index.json")
    fi
  else
    echo "  MISSING  run: omagif setup"
    status=1
  fi

  echo
  echo "Plugin:"
  if command -v omarchy >/dev/null 2>&1 && omarchy plugin list 2>/dev/null | grep -q "$PLUGIN_ID"; then
    echo "  ok       $PLUGIN_ID discovered by the shell"
  else
    echo "  MISSING  $PLUGIN_ID not discovered — is it in ~/.config/omarchy/plugins/?"
    status=1
  fi

  [[ $status -eq 0 ]] && echo && echo "All good." || true
  return $status
}

case "${1:-toggle}" in
  toggle) ipc toggle ;;
  open)   ipc summon ;;
  close)  ipc hide ;;
  setup)
    shift
    exec "$ROOT_DIR/setup" "$@"
    ;;
  config)
    if [[ -n ${EDITOR:-} && ${2:-} == "--edit" ]]; then
      mkdir -p "$(dirname "$CONFIG")"
      [[ -f $CONFIG ]] || cp "$ROOT_DIR/omagif.example.json" "$CONFIG"
      exec "$EDITOR" "$CONFIG"
    fi
    echo "$CONFIG"
    ;;
  install)
    shift
    do_install "$@"
    ;;
  doctor)  do_doctor ;;
  history)
    shift
    do_history "$@"
    ;;
  -h | --help | help) usage ;;
  *)
    echo "omagif: unknown command '$1'" >&2
    echo >&2
    usage >&2
    exit 64
    ;;
esac
