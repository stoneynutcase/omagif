#!/bin/bash

# Side-effect worker for the Omagif overlay. The QML only ever runs this
# detached, so everything that touches the network, the clipboard, the
# keyboard, or the filesystem lives here and stays testable from a shell.
#
#   omagif-action <verb> <url> [cache-dir] [save-dir] [title]
#
# Verbs:
#   cache       download the GIF into the cache and print its path
#   copy-image  put the GIF on the clipboard as image/gif
#   copy-file   put the GIF on the clipboard as text/uri-list (a pasted file)
#   copy-url    put the GIF's URL on the clipboard as text
#   paste-url   copy the URL and paste it into the focused window
#   save        copy the GIF into the save directory under a readable name
#   open        open the GIF's URL in the default browser
#
# The three copy verbs exist because the Wayland clipboard carries one payload
# at a time and no single one pastes everywhere: `image/gif` is raw bytes that
# some apps re-encode to a still frame, `text/uri-list` is a file reference
# that chat apps attach whole (animation intact), and the plain URL is what
# anything with link unfurling turns back into a playing GIF.
#
# Every URL that reaches this script came out of a remote response — a search
# API's JSON, or markup scraped off a search page — so this is the boundary
# where one stops being text and starts being something we act on. Nothing
# below runs until the URL is https on a host providers/index.json names, and
# nothing is displayed, copied or saved until the bytes are inside the size and
# dimension limits. The overlay displays only what came through here.

set -euo pipefail

verb="${1:-}"
url="${2:-}"
cache_dir="${3:-$HOME/.cache/omagif}"
save_dir="${4:-$HOME/Pictures/gifs}"
title="${5:-}"

# Resolved through symlinks for the same reason bin/omagif does it: the
# provider catalogue is found relative to this file, not to however it was
# invoked.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CATALOGUE="$ROOT_DIR/providers/index.json"

# A GIF larger than this in either direction is refused before any decoder sees
# it — the picker's own cells are a couple of hundred pixels.
MAX_DIMENSION=4096

if [[ -z $verb || -z $url ]]; then
  echo "usage: omagif-action <verb> <url> [cache-dir] [save-dir] [title]" >&2
  exit 64
fi

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a Omagif -i image-x-generic "$1" "${2:-}" || true
  fi
}

# The overlay launches this detached, so stdout and stderr go nowhere. Keeping
# a small log is the only way to find out why a paste or a copy did nothing.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omagif"
LOG="$LOG_DIR/omagif.log"

log() {
  mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null || true
  # Keep it from growing without bound; this is a breadcrumb trail, not history.
  if [[ $(wc -l <"$LOG" 2>/dev/null || echo 0) -gt 500 ]]; then
    tail -n 200 "$LOG" >"$LOG.trim" 2>/dev/null && mv -f "$LOG.trim" "$LOG"
  fi
}

# Reads one setting out of the plugin config, falling back to a default.
setting() {
  local key="$1" fallback="$2" value
  value="$(
    python3 - "${XDG_CONFIG_HOME:-$HOME/.config}/omagif/config.json" "$key" 2>/dev/null <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        data = json.load(fh)
except (OSError, ValueError):
    sys.exit(0)
value = data.get(sys.argv[2]) if isinstance(data, dict) else None
if value is not None and not isinstance(value, (dict, list)):
    print(value)
PY
  )" || true
  printf '%s' "${value:-$fallback}"
}

fail() {
  notify "GIF failed" "$1"
  echo "omagif-action: $1" >&2
  exit 1
}

# ------------------------------------------------------------------- limits

# Whether a URL may be acted on at all: https, and a host that
# providers/index.json lists under some provider's mediaHosts. The union is
# used rather than one provider's list because this script is handed a URL, not
# a provider — Providers.js does the stricter per-provider check on the way in.
#
# Fails closed. An unreadable catalogue, a missing python3 or a URL that will
# not parse all end here, and the verb never runs.
allowed_url() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$1" "$CATALOGUE" <<'PY'
import json, sys
from urllib.parse import urlsplit

url, catalogue = sys.argv[1], sys.argv[2]
try:
    with open(catalogue) as fh:
        data = json.load(fh)
except (OSError, ValueError):
    sys.exit(1)

hosts = set()
for entry in data.get("providers", []):
    if not isinstance(entry, dict):
        continue
    for host in entry.get("mediaHosts") or []:
        if isinstance(host, str) and host.strip():
            hosts.add(host.strip().lower())

try:
    parts = urlsplit(url)
    # .hostname drops any user:password@ and :port, which is where a URL that
    # reads as giphy.com but resolves elsewhere would hide.
    host = (parts.hostname or "").lower()
except ValueError:
    sys.exit(1)

if parts.scheme != "https" or not host:
    sys.exit(1)
sys.exit(0 if any(host == h or host.endswith("." + h) for h in hosts) else 1)
PY
}

# Ceiling on a single download. Tenor's keyless provider alone serves GIFs in
# the 10-20 MB range, so the default has real headroom; `maxDownloadMB` in the
# config moves it for anyone on a metered connection.
max_bytes() {
  local mb
  mb="$(setting maxDownloadMB 48)"
  [[ $mb =~ ^[0-9]+$ ]] || mb=48
  ((mb < 1)) && mb=1
  ((mb > 256)) && mb=256
  printf '%s' $((mb * 1024 * 1024))
}

# A GIF states its canvas size in bytes 7-10 of the header, so an image that
# would decode into something enormous can be refused while it is still a file
# on disk. Frame count is not in the header and cannot be known this cheaply —
# the byte ceiling is what bounds that.
gif_ok() {
  python3 - "$1" "$MAX_DIMENSION" <<'PY'
import sys

path, limit = sys.argv[1], int(sys.argv[2])
try:
    with open(path, "rb") as fh:
        head = fh.read(10)
except OSError:
    sys.exit(1)

if len(head) < 10 or head[:6] not in (b"GIF87a", b"GIF89a"):
    sys.exit(1)
width = head[6] | head[7] << 8
height = head[8] | head[9] << 8
sys.exit(0 if 0 < width <= limit and 0 < height <= limit else 1)
PY
}

if ! allowed_url "$url"; then
  fail "refused a URL that is not https on a host in providers/index.json"
fi

# Content-addressed so the same GIF is only ever downloaded once, and so a
# title full of slashes and quotes can never shape a path.
cache_path() {
  local hash
  hash="$(printf '%s' "$1" | sha1sum | cut -d' ' -f1)"
  printf '%s/%s.gif' "$cache_dir" "$hash"
}

# Prints the local path of the GIF, downloading it first if it isn't cached.
# Downloads land on a .part file and are moved into place only once complete,
# so an interrupted run can't leave a truncated GIF in the cache.
fetch() {
  local path cap size
  path="$(cache_path "$url")"
  if [[ -s $path ]]; then
    printf '%s' "$path"
    return 0
  fi
  cap="$(max_bytes)"
  mkdir -p "$cache_dir"
  # --proto/--proto-redir: -L follows redirects, and a redirect is a second URL
  # nobody checked — this keeps every hop https. --max-filesize stops a
  # transfer whose declared size is over the ceiling.
  if ! curl -fsSL --max-time 45 \
       --proto '=https' --proto-redir '=https' \
       --max-filesize "$cap" \
       -o "$path.part" "$url"; then
    rm -f "$path.part"
    return 1
  fi
  # A chunked response declares no size, so curl can only stop it as it
  # arrives. Measure what actually landed, and check it is a GIF of a sane
  # size before anything is asked to decode it.
  size="$(wc -c <"$path.part" 2>/dev/null || echo 0)"
  if ((size == 0 || size > cap)) || ! gif_ok "$path.part"; then
    rm -f "$path.part"
    return 1
  fi
  mv -f "$path.part" "$path"
  printf '%s' "$path"
}

# Lowercased, punctuation-free, and length-capped — a GIF title is arbitrary
# remote text, so nothing from it reaches the filesystem unfiltered.
slug() {
  local s
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-')"
  s="${s#-}"
  s="${s%-}"
  printf '%s' "${s:0:48}"
}

case "$verb" in
  cache)
    path="$(fetch)" || exit 1
    printf '%s' "$path"
    ;;

  copy-image)
    path="$(fetch)" || fail "could not download the GIF"
    # wl-copy forks and keeps serving the selection after we exit.
    wl-copy --type image/gif <"$path" || fail "could not reach the clipboard"
    notify "GIF copied" "Paste it wherever you like"
    ;;

  copy-file)
    path="$(fetch)" || fail "could not download the GIF"
    # Cache files are named by hash, but this one gets attached to a message
    # with its name showing, so hand the receiving app a readable one. A
    # hardlink costs nothing and keeps a single copy of the bytes.
    name="$(slug "$title")"
    [[ -n $name ]] || name="gif"
    mkdir -p "$cache_dir/named"
    link="$cache_dir/named/$name.gif"
    if [[ -e $link ]] && ! cmp -s "$path" "$link"; then
      # Same title, different GIF — keep both rather than swapping the file
      # out from under a paste that hasn't happened yet.
      link="$cache_dir/named/$name-$(basename "$path" .gif | cut -c1-6).gif"
    fi
    ln -f "$path" "$link" 2>/dev/null || cp -f "$path" "$link"

    # A uri-list is CRLF-terminated by spec, and the path is percent-encoded
    # properly rather than pasted in raw, so a cache directory with a space in
    # it still produces a URI the receiving app can resolve.
    uri="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$link")"
    printf '%s\r\n' "$uri" | wl-copy --type text/uri-list || fail "could not reach the clipboard"
    notify "GIF copied as a file" "$(basename "$link")"
    ;;

  copy-url)
    printf '%s' "$url" | wl-copy --type text/plain || fail "could not reach the clipboard"
    notify "Link copied" "$url"
    ;;

  paste-url)
    # Copy first and leave it there. The emoji picker holds the selection only
    # for the length of the paste and then drops it, but a link is worth
    # keeping: if the synthetic keypress misses, Ctrl+V still works instead of
    # leaving the user with nothing.
    printf '%s' "$url" | wl-copy --type text/plain || fail "could not reach the clipboard"

    # The overlay has just unmapped a layer surface that held *exclusive*
    # keyboard focus. The compositor hands focus back asynchronously, and a
    # keypress sent before that lands nowhere — the single most likely reason
    # an auto-paste silently does nothing.
    delay="$(setting pasteDelayMs 300)"
    [[ $delay =~ ^[0-9]+$ ]] || delay=300
    sleep "$(awk "BEGIN { printf \"%.3f\", $delay / 1000 }")"

    # Ctrl+V by default: Electron apps (Signal, Slack, Discord) handle it far
    # more reliably than Shift+Insert.
    case "$(setting pasteKey ctrl+v)" in
      shift+insert) keys=(-M shift -k Insert -m shift) ;;
      ctrl+shift+v) keys=(-M ctrl -M shift -k v -m shift -m ctrl) ;;
      *) keys=(-M ctrl -k v -m ctrl) ;;
    esac

    if wtype "${keys[@]}" 2>>"$LOG"; then
      log "paste-url: sent ${keys[*]} after ${delay}ms"
    else
      log "paste-url: wtype ${keys[*]} failed; link left on the clipboard"
      notify "Link copied" "Auto-paste didn't land — press Ctrl+V"
    fi
    ;;

  save)
    path="$(fetch)" || fail "could not download the GIF"
    mkdir -p "$save_dir"
    name="$(slug "$title")"
    [[ -n $name ]] || name="gif"
    dest="$save_dir/$name.gif"
    # Never clobber: walk a suffix until the name is free.
    n=2
    while [[ -e $dest ]]; do
      if cmp -s "$path" "$dest"; then
        notify "Already saved" "$dest"
        exit 0
      fi
      dest="$save_dir/$name-$n.gif"
      n=$((n + 1))
    done
    cp "$path" "$dest"
    notify "GIF saved" "$dest"
    ;;

  open)
    xdg-open "$url" >/dev/null 2>&1 &
    ;;

  *)
    echo "omagif-action: unknown verb '$verb'" >&2
    exit 64
    ;;
esac
